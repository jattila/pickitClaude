[debug] [2026-07-24T17:08:45.015Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/pickitclaude/rulesets {"name":"projects/pickitclaude/rulesets/fa2b3269-f144-4e67-9e1c-bde809ecafed","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isGroupMember(groupData) {\n      return isSignedIn() && request.auth.uid in groupData.memberIds;\n    }\n\n    // Personal (non-group) lists: only the owner can access.\n    function isPersonalListOwner(listData) {\n      return isSignedIn() && listData.ownerId == request.auth.uid && listData.groupId == null;\n    }\n\n    // Group lists: any current member of the owning group can access.\n    function isGroupListMember(listData) {\n      return listData.groupId != null\n        && isGroupMember(get(/databases/$(database)/documents/groups/$(listData.groupId)).data);\n    }\n\n    function canAccessList(listData) {\n      return isPersonalListOwner(listData) || isGroupListMember(listData);\n    }\n\n    match /users/{uid} {\n      allow read, write: if isSignedIn() && request.auth.uid == uid;\n\n      match /devices/{tokenId} {\n        allow read, write: if isSignedIn() && request.auth.uid == uid;\n      }\n\n      // Personal catalog: client reads for autocomplete; the onItemCreated /\n      // onItemUpdated triggers (Admin SDK) own all writes.\n      match /catalog/{catalogItemId} {\n        allow read: if isSignedIn() && request.auth.uid == uid;\n        allow write: if false;\n      }\n    }\n\n    match /groups/{groupId} {\n      allow read: if isGroupMember(resource.data);\n      allow create: if isSignedIn()\n        && request.resource.data.ownerId == request.auth.uid\n        && request.resource.data.memberIds.size() == 1\n        && request.resource.data.memberIds[0] == request.auth.uid;\n      // Owner can rename etc., but membership only ever changes via the\n      // redeemInvite Cloud Function (Admin SDK bypasses these rules).\n      allow update: if isSignedIn()\n        && resource.data.ownerId == request.auth.uid\n        && request.resource.data.ownerId == resource.data.ownerId\n        && request.resource.data.memberIds == resource.data.memberIds;\n      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;\n\n      match /members/{uid} {\n        allow read: if isGroupMember(get(/databases/$(database)/documents/groups/$(groupId)).data);\n        // Only used for the creator's own owner-member doc at group creation\n        // time; joining via invite is written server-side by redeemInvite.\n        allow create: if isSignedIn() && request.auth.uid == uid && request.resource.data.role == 'owner';\n        allow update: if false;\n        // Cleanup when the owner deletes the whole group (client cascade-delete).\n        allow delete: if isSignedIn() && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;\n      }\n\n      // Group catalog land in M4 alongside the Cloud Function item triggers\n      // that will own writes to it; client read-only for now.\n      match /catalog/{catalogItemId} {\n        allow read: if isGroupMember(get(/databases/$(database)/documents/groups/$(groupId)).data);\n        allow write: if false;\n      }\n    }\n\n    // No direct client access — previewing and redeeming both go through\n    // Cloud Functions (Admin SDK), so the group's *current* name is used\n    // instead of a denormalized snapshot that would go stale on rename.\n    match /invites/{code} {\n      allow read, write: if false;\n    }\n\n    match /lists/{listId} {\n      // resource == null means a get() on a not-yet-created list (e.g. resolving\n      // a group's deterministic-id default list on first open); allowing it leaks\n      // nothing — an existing list the caller can't access still fails below.\n      allow read: if resource == null || canAccessList(resource.data);\n      allow create: if isSignedIn()\n        && request.resource.data.ownerId == request.auth.uid\n        && (\n          request.resource.data.groupId == null\n          || isGroupMember(get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data)\n        );\n      allow update, delete: if canAccessList(resource.data);\n\n      match /items/{itemId} {\n        allow read, write: if canAccessList(get(/databases/$(database)/documents/lists/$(listId)).data);\n      }\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-07-24T17:08:44.960943Z","metadata":{"services":["cloud.firestore"]}}
