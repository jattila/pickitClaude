rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupData) {
      return isSignedIn() && request.auth.uid in groupData.memberIds;
    }

    // Personal (non-group) lists: only the owner can access.
    function isPersonalListOwner(listData) {
      return isSignedIn() && listData.ownerId == request.auth.uid && listData.groupId == null;
    }

    // Group lists: any current member of the owning group can access.
    function isGroupListMember(listData) {
      return listData.groupId != null
        && isGroupMember(get(/databases/$(database)/documents/groups/$(listData.groupId)).data);
    }

    function canAccessList(listData) {
      return isPersonalListOwner(listData) || isGroupListMember(listData);
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;

      match /devices/{tokenId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      // Personal catalog: client reads for autocomplete; the onItemCreated /
      // onItemUpdated triggers (Admin SDK) own all writes.
      match /catalog/{catalogItemId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /groups/{groupId} {
      allow read: if isGroupMember(resource.data);
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid;
      // Owner can rename etc., but membership only ever changes via the
      // redeemInvite Cloud Function (Admin SDK bypasses these rules).
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds == resource.data.memberIds;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{uid} {
        allow read: if isGroupMember(get(/databases/$(database)/documents/groups/$(groupId)).data);
        // Only used for the creator's own owner-member doc at group creation
        // time; joining via invite is written server-side by redeemInvite.
        allow create: if isSignedIn() && request.auth.uid == uid && request.resource.data.role == 'owner';
        allow update: if false;
        // Cleanup when the owner deletes the whole group (client cascade-delete).
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
      }

      // Group catalog land in M4 alongside the Cloud Function item triggers
      // that will own writes to it; client read-only for now.
      match /catalog/{catalogItemId} {
        allow read: if isGroupMember(get(/databases/$(database)/documents/groups/$(groupId)).data);
        allow write: if false;
      }
    }

    // No direct client access — previewing and redeeming both go through
    // Cloud Functions (Admin SDK), so the group's *current* name is used
    // instead of a denormalized snapshot that would go stale on rename.
    match /invites/{code} {
      allow read, write: if false;
    }

    match /lists/{listId} {
      // resource == null means a get() on a not-yet-created list (e.g. resolving
      // a group's deterministic-id default list on first open); allowing it leaks
      // nothing — an existing list the caller can't access still fails below.
      allow read: if resource == null || canAccessList(resource.data);
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && (
          request.resource.data.groupId == null
          || isGroupMember(get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data)
        );
      allow update, delete: if canAccessList(resource.data);

      match /items/{itemId} {
        allow read, write: if canAccessList(get(/databases/$(database)/documents/lists/$(listId)).data);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
