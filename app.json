{
  "expo": {
    "name": "PickIt",
    "slug": "pickit",
    "scheme": "pickit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pickitclaude.app",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.pickitclaude.app",
      "googleServicesFile": "./google-services.json",
      "//": "Neither Notifee nor RNFirebase messaging declares POST_NOTIFICATIONS, and without it Android 13+ blocks notifications outright — the permission prompt never even appears.",
      "permissions": ["android.permission.POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "//keyboard": "pan, not resize: under SDK 54 edge-to-edge Android no longer resizes the window for the IME, and the reported keyboard height excludes vendor toolbars (Samsung). Panning lets the OS reveal the focused input using geometry it actually knows.",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "./plugins/withFirebaseStaticFramework"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b4dfe696-2f33-42f8-83ac-d851ffd42913"
      }
    },
    "owner": "jattila"
  }
}
