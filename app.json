{
  "expo": {
    "name": "PickIt",
    "slug": "pickit",
    "scheme": "pickit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pickitclaude.app",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.pickitclaude.app",
      "googleServicesFile": "./google-services.json",
      "//": "Neither Notifee nor RNFirebase messaging declares POST_NOTIFICATIONS, and without it Android 13+ blocks notifications outright — the permission prompt never even appears.",
      "permissions": ["android.permission.POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "//keyboard": "resize is what react-native-keyboard-controller expects; it reads the real IME insets itself. pan was the stopgap before it, and moved the header along with everything else.",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "@react-native-firebase/analytics",
        {
          "ios": {
            "//": "Links the Analytics build that never touches the IDFA. We only want to know how many people use the app and which screens they open — none of that needs an advertising identifier, and asking for one would drag in App Tracking Transparency and a 'tracking' declaration on the App Store.",
            "withoutAdIdSupport": true
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "./plugins/withFirebaseStaticFramework"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b4dfe696-2f33-42f8-83ac-d851ffd42913"
      }
    },
    "owner": "jattila"
  }
}
